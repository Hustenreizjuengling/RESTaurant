app RESTAURANT (
    name: RESTaurant
    version: 1.1.2
    logo {
        type: imageAndText
        imageUrl: #APP_FILES#icons/app-icon-192.png
        text: RESTaurant
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-navCollapsed--default
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
        autoDismissSuccessMessages: true
    }
    css {
        fileUrls: #APP_FILES#css/restaurant.css
    }
    javaScript {
        fileUrls: #APP_FILES#js/restaurant.js
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    authorization {
        scheme: @ist-admin
    }
    runtime {
        compatibilityMode: 24.2
    }
    advanced {
        modernizeApp: true
    }
    comments {
        comments: Editor for ORDS RESTful services. Everything runs inside the application, no database objects are required.
    }

    substitution APP_VERSION (
        value {
            staticValue: 1.1.2
        }
    )

)
