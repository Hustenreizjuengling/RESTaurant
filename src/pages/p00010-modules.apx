    button import (
        buttonName: IMPORT
        label: Import
        layout {
            sequence: 30
            region: @heading
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 70
                clearCache: 70
            }
