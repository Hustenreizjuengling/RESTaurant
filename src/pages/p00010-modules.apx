page 10 (
    name: Modules
    alias: MODULES
    title: Modules
    pageGroup: @services
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    help {
        helpText: Lists the resource modules of the schema. Open a module to edit its templates and handlers, or use the tree on the left to jump to any element.
    }

    region heading (
        name: Heading
        title: Modules
        type: staticContent
        source {
            htmlCode: Resource modules group the templates and handlers of a RESTful service.
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
            icon: fa-sitemap-horizontal
        }
    )

    region service-tree (
        name: Service Tree
        type: plugin/restaurantTree
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region check (
        name: Compile Check
        title: Compile check
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    l_html   clob;
                    l_buffer varchar2(32767);
                    l_errors pls_integer := 0;
                    l_total  pls_integer := 0;
                    l_module varchar2(255);

                    procedure p (p_text in varchar2) is
                    begin
                        if nvl(lengthb(l_buffer), 0) + nvl(lengthb(p_text), 0) > 32000 then
                            dbms_lob.writeappend(l_html, length(l_buffer), l_buffer);
                            l_buffer := null;
                        end if;
                        l_buffer := l_buffer || p_text;
                    end p;
                begin
                    dbms_lob.createtemporary(l_html, true);
                    select count(*), count(case when c001 = 'ERROR' then 1 end)
                      into l_total, l_errors
                      from apex_collections
                     where collection_name = 'RESTAURANT_CHECK';
                    select max(name) into l_module from user_ords_modules where id = :P10_ID;
                    p('<div class="rst-toolbar"><span class="rst-status rst-status--' || case when l_errors = 0 then 'on' else 'off' end || '">'
                      || case
                             when l_total = 0  then 'No handlers to check'
                             when l_errors = 0 then 'All ' || l_total || ' handlers compile'
                             else l_errors || ' of ' || l_total || ' handlers do not compile'
                         end
                      || '</span><span class="rst-muted">'
                      || case when l_module is not null then 'Module ' || apex_escape.html(l_module) else 'All modules' end
                      || ' · checked by the database without running the code</span></div>');
                    if l_errors > 0 then
                        p('<table class="rst-table"><thead><tr><th>Handler</th><th>Module</th><th>Position</th><th>Error</th></tr></thead><tbody>');
                        for c in ( select c002 method, c003 path, c004 module_name, c005 message, n001 handler_id, n002 line, n003 col
                                     from apex_collections
                                    where collection_name = 'RESTAURANT_CHECK'
                                      and c001 = 'ERROR'
                                    order by seq_id )
                        loop
                            p('<tr><td><a class="rst-method rst-method--' || lower(apex_escape.html_attribute(c.method)) || '" href="'
                              || apex_page.get_url(p_page => 13, p_items => 'P13_ID', p_values => c.handler_id) || '">' || apex_escape.html(c.method) || '</a> '
                              || '<a class="rst-path" href="' || apex_page.get_url(p_page => 13, p_items => 'P13_ID', p_values => c.handler_id) || '">'
                              || apex_escape.html(c.path) || '</a></td><td>' || apex_escape.html(c.module_name) || '</td>'
                              || '<td class="rst-mono">' || case when c.line is not null then c.line || ':' || c.col end || '</td>'
                              || '<td>' || apex_escape.html(c.message) || '</td></tr>');
                        end loop;
                        p('</tbody></table>');
                    end if;
                    if l_buffer is not null then
                        dbms_lob.writeappend(l_html, length(l_buffer), l_buffer);
                    end if;
                    return l_html;
                end;
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P10_CHECK
            value: Y
        }
    )

    region modules (
        name: Modules
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    l_html   clob;
                    l_buffer varchar2(32767);
                    l_count  pls_integer := 0;

                    procedure p (p_text in varchar2) is
                    begin
                        if nvl(lengthb(l_buffer), 0) + nvl(lengthb(p_text), 0) > 32000 then
                            dbms_lob.writeappend(l_html, length(l_buffer), l_buffer);
                            l_buffer := null;
                        end if;
                        l_buffer := l_buffer || p_text;
                    end p;
                begin
                    dbms_lob.createtemporary(l_html, true);
                    p('<div class="rst-toolbar"><input type="search" class="rst-filter" data-target="#rst-modules" placeholder="Filter modules" aria-label="Filter modules"></div>');
                    p('<table class="rst-table" id="rst-modules"><thead><tr>'
                      || '<th>Module</th><th>Base path</th><th>Status</th><th class="rst-num">Templates</th><th class="rst-num">Handlers</th><th>Protected by</th><th>Changed</th><th></th>'
                      || '</tr></thead><tbody>');
                    for m in ( select m.id, m.name, m.uri_prefix, m.status, m.comments, m.updated_on, m.updated_by,
                                      ( select count(*) from user_ords_templates t where t.module_id = m.id ) templates,
                                      ( select count(*)
                                          from user_ords_templates t
                                          join user_ords_handlers h on h.template_id = t.id
                                         where t.module_id = m.id ) handlers,
                                      ( select max(pm.privilege_name) from user_ords_privilege_modules pm where pm.module_id = m.id ) privilege_name
                                 from user_ords_modules m
                                order by m.name )
                    loop
                        l_count := l_count + 1;
                        p('<tr><td><a class="rst-strong" href="' || apex_page.get_url(p_page => 11, p_items => 'P11_ID', p_values => m.id) || '">'
                          || apex_escape.html(m.name) || '</a>'
                          || case when m.comments is not null then '<div class="rst-muted">' || apex_escape.html(m.comments) || '</div>' end
                          || '</td><td><span class="rst-path">' || apex_escape.html(m.uri_prefix) || '</span></td>'
                          || '<td><span class="rst-status rst-status--' || case m.status when 'PUBLISHED' then 'on">Published' else 'off">Not published' end || '</span></td>'
                          || '<td class="rst-num">' || m.templates || '</td><td class="rst-num">' || m.handlers || '</td>'
                          || '<td>' || case when m.privilege_name is not null
                                            then '<span class="fa fa-lock" aria-hidden="true"></span> ' || apex_escape.html(m.privilege_name)
                                            else '<span class="rst-muted">Public</span>' end || '</td>'
                          || '<td><span title="' || apex_escape.html_attribute(m.updated_by) || '">' || apex_escape.html(apex_util.get_since(m.updated_on)) || '</span></td>'
                          || '<td class="rst-actions">'
                          || '<a class="rst-icon-link" title="Export as JSON" aria-label="Export as JSON" href="'
                          || apex_page.get_url(p_page => 61, p_clear_cache => '61', p_items => 'P61_SCOPE,P61_ID,P61_FORMAT,P61_INCLUDE_SECURITY', p_values => 'MODULE,' || m.id || ',JSON,Y')
                          || '"><span class="fa fa-download" aria-hidden="true"></span></a></td></tr>');
                    end loop;
                    p('</tbody></table>');
                    if l_count = 0 then
                        p('<div class="rst-empty"><span class="fa fa-cubes" aria-hidden="true"></span>'
                          || '<p>This schema has no resource modules yet.</p>'
                          || '<p class="rst-muted">Create the first module or import an export file.</p></div>');
                    end if;
                    if l_buffer is not null then
                        dbms_lob.writeappend(l_html, length(l_buffer), l_buffer);
                    end if;
                    return l_html;
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
    )

    pageItem P10_CHECK (
        type: hidden
        layout {
            sequence: 10
            region: @heading
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        sessionState {
            storage: request
        }
    )

    pageItem P10_ID (
        type: hidden
        layout {
            sequence: 20
            region: @heading
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
        sessionState {
            storage: request
        }
    )

    button create (
        buttonName: CREATE
        label: Create Module
        layout {
            sequence: 10
            region: @heading
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
        }
    )

    button search (
        buttonName: SEARCH
        label: Search Source
        layout {
            sequence: 15
            region: @heading
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-search
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 16
                clearCache: 16
            }
        }
    )

    button check (
        buttonName: CHECK
        label: Check Handlers
        layout {
            sequence: 17
            region: @heading
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check-circle-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
                items: {
                    P10_CHECK: Y
                }
            }
        }
    )

    button export (
        buttonName: EXPORT
        label: Export
        layout {
