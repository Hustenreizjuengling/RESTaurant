    process check-handlers (
        name: Check Handlers
        type: plugin/restaurantEngine
        settings {
            action: HANDLERS_CHECK
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: item=value
            item: P10_CHECK
            value: Y
        }
        advanced {
            executionMappingIdentifier: 1001
        }
    )

)
