page 13 (
    name: Handler
    alias: HANDLER
    title: Handler
    pageGroup: @services
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript
            (function () {
                var method = apex.item("P13_METHOD"),
                    type = apex.item("P13_SOURCE_TYPE");

                function isCode(value) {
                    return value === "plsql/block" || value === "mle/javascript";
                }

                // only GET handlers can be queries, everything else is code
                function sync() {
                    var get = method.getValue() === "GET";
                    apex.jQuery("#P13_SOURCE_TYPE option").each(function () {
                        this.disabled = !get && !isCode(this.value);
                        this.hidden = this.disabled;
                    });
                    if (!get && !isCode(type.getValue())) {
                        type.setValue("plsql/block");
                    }
                    apex.item("P13_ITEMS_PER_PAGE")[get ? "show" : "hide"]();
                    apex.item("P13_MIMES_ALLOWED")[method.getValue() === "POST" || method.getValue() === "PUT" ? "show" : "hide"]();
                    apex.item("P13_MLE_ENV_NAME")[type.getValue() === "mle/javascript" ? "show" : "hide"]();
                }

                apex.jQuery("#P13_METHOD, #P13_SOURCE_TYPE").on("change", sync);
                sync();
            })();
            ```
    }
    help {
        helpText: A resource handler answers one HTTP method of a template. GET handlers are usually queries, all other methods run PL/SQL.
    }

    region heading (
        name: Heading
        title: &P13_TITLE.
        type: staticContent
        source {
            htmlCode: Resource handler of <a href="&P13_TEMPLATE_URL!ATTR.">&P13_TEMPLATE_NAME.</a> in module <a href="&P13_MODULE_URL!ATTR.">&P13_MODULE_NAME.</a>
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
            icon: fa-bolt
        }
    )

    region service-tree (
        name: Service Tree
        type: plugin/restaurantTree
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region handler (
        name: Handler
        title: Definition
        type: staticContent
