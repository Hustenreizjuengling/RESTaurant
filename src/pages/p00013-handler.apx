            type: staticValues
            staticValues: STATIC2:Collection Query;json/collection,Collection Query Item;json/item,PL/SQL;plsql/block,Media Resource;resource/lob,MLE JavaScript;mle/javascript,Query (legacy);json/query,Query as CSV (legacy);csv/query,Query One Row (legacy);json/query\;type=single,Feed (legacy);json/query\;type=feed
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @handler
            slot: regionBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: json/collection
        }
        help {
            helpText:
                ```html
                <p><strong>Collection Query</strong> returns the rows of a query as a paged JSON collection, <strong>Collection Query Item</strong> a single row as one JSON object.</p>
                <p><strong>PL/SQL</strong> runs an anonymous block. OUT parameters become the response.</p>
                <p><strong>Media Resource</strong> expects a query that returns a content type and a LOB and sends the LOB as the response.</p>
                <p><strong>MLE JavaScript</strong> runs a JavaScript function in the database.</p>
                ```
        }
