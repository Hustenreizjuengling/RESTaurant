page 71 (
    name: Review Import
    alias: REVIEW-IMPORT
    title: Review Import
    pageGroup: @transfer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    help {
        helpText:
            ```html
            <p>Compares the loaded export with the schema. Every element of the file is marked as new, changed or unchanged. Elements that exist only in the schema are listed as well.</p>
            <p><strong>Merge</strong> adds and updates the templates and handlers of the file and keeps everything else. <strong>Replace</strong> makes an existing module exactly like the file, so templates and handlers that are only in the schema are removed. <strong>Skip</strong> imports new modules only.</p>
            <p>A file that contains a single template or handler is always merged into its module.</p>
            ```
    }

    region heading (
        name: Heading
        title: Review Import
        type: staticContent
        source {
            htmlCode: Loaded from <strong>&P71_SOURCE.</strong>. Nothing has been changed yet.
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
            icon: fa-upload
        }
    )

    region steps (
        name: Steps
        type: staticContent
        source {
            htmlCode:
                ```html
                <ol class="rst-steps">
                    <li class="is-done"><span>1</span> Load the export</li>
                    <li class="is-active"><span>2</span> Review and import</li>
                </ol>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region options (
        name: Options
        title: How to import
        type: staticContent
        layout {
            sequence: 30
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region plan (
        name: Plan
        title: Content of the export
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    l_html   clob;
                    l_buffer varchar2(32767);

                    procedure p (p_text in varchar2) is
                    begin
                        if nvl(lengthb(l_buffer), 0) + nvl(lengthb(p_text), 0) > 32000 then
                            dbms_lob.writeappend(l_html, length(l_buffer), l_buffer);
                            l_buffer := null;
                        end if;
                        l_buffer := l_buffer || p_text;
                    end p;
                begin
                    dbms_lob.createtemporary(l_html, true);
                    p('<div class="rst-toolbar">');
                    for s in ( select c003 status, count(*) elements
                                 from apex_collections
                                where collection_name = 'RESTAURANT_PLAN'
                                group by c003
                                order by decode(c003, 'NEW', 1, 'CHANGED', 2, 'UNCHANGED', 3, 4) )
                    loop
                        p('<span class="rst-status rst-status--' || lower(s.status) || '">' || s.elements || ' '
                          || case s.status when 'NEW' then 'new' when 'CHANGED' then 'changed' when 'UNCHANGED' then 'unchanged' else 'only in the schema' end
                          || '</span>');
                    end loop;
                    p('</div><table class="rst-table"><thead><tr><th>Element</th><th>Compared with the schema</th></tr></thead><tbody>');
                    for r in ( select c001 kind, c002 label, c003 status, c005 info, n001 lvl
                                 from apex_collections
                                where collection_name = 'RESTAURANT_PLAN'
                                order by seq_id )
                    loop
                        p('<tr><td class="rst-indent-' || r.lvl || '">'
                          || case r.kind
                                 when 'MODULE'    then '<span class="fa fa-cubes rst-node-icon" aria-hidden="true"></span> <span class="rst-strong">' || apex_escape.html(r.label) || '</span>'
                                                       || ' <span class="rst-muted rst-path">' || apex_escape.html(r.info) || '</span>'
                                 when 'TEMPLATE'  then '<span class="rst-path">' || apex_escape.html(r.label) || '</span>'
                                 when 'HANDLER'   then '<span class="rst-method rst-method--' || lower(apex_escape.html_attribute(r.label)) || '">' || apex_escape.html(r.label) || '</span>'
                                 when 'PRIVILEGE' then '<span class="fa fa-shield rst-node-icon" aria-hidden="true"></span> Privilege <span class="rst-strong">' || apex_escape.html(r.label) || '</span>'
                                 when 'ROLE'      then '<span class="fa fa-users rst-node-icon" aria-hidden="true"></span> Role <span class="rst-strong">' || apex_escape.html(r.label) || '</span>'
                             end
                          || '</td><td><span class="rst-status rst-status--' || lower(r.status) || '">'
                          || case r.status when 'NEW' then 'New' when 'CHANGED' then 'Changed' when 'UNCHANGED' then 'Unchanged' else 'Only in the schema' end
                          || '</span></td></tr>');
                    end loop;
                    p('</tbody></table>');
                    if l_buffer is not null then
                        dbms_lob.writeappend(l_html, length(l_buffer), l_buffer);
                    end if;
                    return l_html;
                end;
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
    )

    pageItem P71_SOURCE (
        type: hidden
        layout {
            sequence: 10
            region: @options
            slot: regionBody
        }
        security {
            sessionStateProtection: restricted
        }
    )

    pageItem P71_MODE (
        type: radioGroup
        label {
            label: Modules that already exist
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Merge - add and update but keep the rest;MERGE,Replace - make them exactly like the file;REPLACE,Skip - import new modules only;SKIP
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @options
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: MERGE
        }
    )

    pageItem P71_MODULES (
        type: checkboxGroup
        label {
            label: Modules to import
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c002 d, c002 r
                  from apex_collections
                 where collection_name = 'RESTAURANT_PLAN'
                   and c001 = 'MODULE'
                 order by seq_id
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 30
            region: @options
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from apex_collections
                 where collection_name = 'RESTAURANT_PLAN'
                   and c001 = 'MODULE'
                ```
        }
    )

    pageItem P71_IMPORT_SECURITY (
        type: switch
        label {
            label: Import privileges and roles
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Yes
            offValue: N
            offLabel: No
        }
        layout {
            sequence: 40
            region: @options
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        help {
            helpText: Creates the roles and defines the privileges of the file. Module links of existing privileges are kept.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from apex_collections
                 where collection_name = 'RESTAURANT_PLAN'
                   and c001 in ('ROLE', 'PRIVILEGE')
                ```
        }
    )

    pageItem P71_STATUS (
        type: selectList
        label {
            label: Publication status
        }
        lov {
            type: staticValues
            staticValues: STATIC2:As in the file;KEEP,Import as not published;NOT_PUBLISHED,Import as published;PUBLISHED
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @options
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: KEEP
        }
        help {
            helpText: Import as not published to check the services before they go live.
        }
    )

    pageItem P71_NEW_NAME (
        type: textField
        label {
            label: Import under another module name
        }
        layout {
            sequence: 60
            region: @options
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            maxLength: 255
        }
        help {
            helpText: Optional. Imports the module of the file under this name, for example to create a copy or a new version.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from apex_collections
                 where collection_name = 'RESTAURANT_PLAN'
                   and c001 = 'MODULE'
                having count(*) = 1
                ```
        }
    )

    pageItem P71_NEW_BASE_PATH (
        type: textField
        label {
            label: Import under another base path
        }
        layout {
            sequence: 70
            region: @options
            slot: regionBody
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            cssClasses: rst-mono
        }
        validation {
            maxLength: 255
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from apex_collections
                 where collection_name = 'RESTAURANT_PLAN'
                   and c001 = 'MODULE'
                having count(*) = 1
                ```
        }
    )

    button import (
        buttonName: IMPORT
        label: Import
        layout {
            sequence: 10
            region: @heading
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back (
        buttonName: BACK
        label: Choose Another File
        layout {
            sequence: 20
            region: @heading
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 70
                clearCache: 70
            }
        }
    )

    process prepare (
        name: Prepare
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P71_SOURCE := null;
                for d in ( select c002 source
                             from apex_collections
                            where collection_name = 'RESTAURANT_DOC'
                              and c001 = 'IMPORT' )
                loop
                    :P71_SOURCE := d.source;
                end loop;
                if :P71_SOURCE is null then
                    -- nothing is loaded, start with the first step
                    apex_util.redirect_url(apex_page.get_url(p_page => 70));
                end if;
                if :P71_MODULES is null then
                    select listagg(c002, ':') within group (order by seq_id)
                      into :P71_MODULES
                      from apex_collections
                     where collection_name = 'RESTAURANT_PLAN'
                       and c001 = 'MODULE';
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 7101
        }
    )

    process apply-import (
        name: Apply Import
        type: plugin/restaurantEngine
        settings {
            action: IMPORT_APPLY
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: request=Value
            value: IMPORT
        }
        advanced {
            executionMappingIdentifier: 7102
        }
    )

    branch to-modules (
        name: To Modules
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 10
            }
        }
    )

)
