customAttribute action (
    apexlangName: action
    attribute: 1
    name: Action
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    help {
        helpText: The operation to execute, for example MODULE_SAVE, HANDLER_DELETE, EXPORT_DOWNLOAD or IMPORT_APPLY.
    }
)

customAttribute itemPrefix (
    apexlangName: itemPrefix
    attribute: 2
    name: Item Prefix
    appearance {
        sequence: 20
    }
    help {
        helpText: Prefix of the page items the engine reads and writes. Defaults to P<page number>_.
    }
)

